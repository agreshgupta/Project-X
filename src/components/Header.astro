---
import { site } from '../data/site';
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#reels', label: 'Reels' },
  { href: '/#about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-40 bg-stage/90 backdrop-blur border-b border-cream/10">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3.5">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name}, home`}>
      <span class="dots sm"><i></i><i></i><i></i></span>
      <span class="font-display text-sm font-extrabold uppercase tracking-tight">SB</span>
    </a>
    <nav class="hidden items-center gap-8 text-sm font-medium md:flex" aria-label="Main">
      {nav.map((n) => <a href={n.href} class="hover:text-lime">{n.label}</a>)}
      <a href={`mailto:${site.email}`} class="btn btn-crimson !py-2 !px-4 !text-sm">Get in touch</a>
    </nav>
    <details class="relative md:hidden">
      <summary class="btn btn-line !py-2 !px-4 !text-sm cursor-pointer list-none">Menu</summary>
      <div class="absolute right-0 mt-2 w-56 rounded-xl bg-cream p-3 text-ink shadow-xl">
        {nav.map((n) => <a href={n.href} class="block rounded-lg px-3 py-2.5 font-medium hover:bg-ink/5">{n.label}</a>)}
        <a href={`mailto:${site.email}`} class="btn btn-crimson mt-2 w-full justify-center">Get in touch</a>
      </div>
    </details>
  </div>
</header>
