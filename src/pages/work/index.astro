---
import Base from '../../layouts/Base.astro';
import { getProjects, categoriesIn, titleOf } from '../../lib/content';
const projects = await getProjects();
const cats = categoriesIn(projects);
---
<Base title="Work | Sanskriti Basnet, Stylist & Visual Merchandiser" description="Campaigns, catalogues and content styled for Flying Machine and U.S. Polo Assn.">
  <section class="on-stage mx-auto max-w-7xl px-5 py-16">
    <a href="/" class="text-sm text-cream/75 hover:text-lime">Back home</a>
    <h1 class="display mt-4 text-5xl md:text-7xl">All work</h1>
    {cats.map((c) => (
      <div class="mt-16">
        <h2 class="font-display text-xl font-extrabold uppercase text-lime">{c}</h2>
        <ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
          {projects.filter((p) => p.category === c).map((p) => (
            <li>
              <a href={`/work/${p.slug}`} class="group block" aria-label={`${titleOf(p)}: view project`}>
                <div class="overflow-hidden" style="aspect-ratio:4/5">
                  <img src={p.cover.src} alt={p.cover.alt} width={p.cover.width} height={p.cover.height} loading="lazy" decoding="async"
                       class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100" style={`object-position:${p.cover.focus ?? 'center 12%'}`} />
                </div>
                <p class="mt-2 font-display text-sm font-extrabold uppercase leading-tight">{p.title} {p.season}</p>
                <p class="text-xs text-cream/70">{p.brand}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>
